  "fixed_sql": [
    {
      "name": "words",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"words\" (\"id\" INTEGER NOT NULL, \"word\" TEXT NOT NULL, \"homonym\" INTEGER NOT NULL DEFAULT 0, \"pos\" TEXT NOT NULL, \"level\" TEXT NOT NULL, \"hanja\" TEXT NULL, \"pronunciation\" TEXT NULL, \"category\" TEXT NULL, \"senses\" TEXT NOT NULL, \"rank\" INTEGER NOT NULL, \"is_custom\" INTEGER NOT NULL DEFAULT 0 CHECK (\"is_custom\" IN (0, 1)), \"starred\" INTEGER NOT NULL DEFAULT 0 CHECK (\"starred\" IN (0, 1)), \"note\" TEXT NULL, \"unit\" TEXT NULL, \"forms\" TEXT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "cards",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"cards\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"word_id\" INTEGER NOT NULL REFERENCES words (id) ON DELETE CASCADE, \"direction\" INTEGER NOT NULL, \"state\" INTEGER NOT NULL DEFAULT 0, \"step\" INTEGER NULL, \"stability\" REAL NULL, \"difficulty\" REAL NULL, \"due\" INTEGER NOT NULL DEFAULT (CAST(strftime('%s', CURRENT_TIMESTAMP) AS INTEGER)), \"last_review\" INTEGER NULL, \"reps\" INTEGER NOT NULL DEFAULT 0, \"lapses\" INTEGER NOT NULL DEFAULT 0, \"suspended\" INTEGER NOT NULL DEFAULT 0 CHECK (\"suspended\" IN (0, 1)), UNIQUE (\"word_id\", \"direction\"));"
        }
      ]
    },
    {
      "name": "review_logs",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"review_logs\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"card_id\" INTEGER NOT NULL REFERENCES cards (id) ON DELETE CASCADE, \"rating\" INTEGER NOT NULL, \"state_before\" INTEGER NOT NULL, \"reviewed_at\" INTEGER NOT NULL, \"elapsed_ms\" INTEGER NOT NULL);"
        }
      ]
    },
    {
      "name": "activities",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"activities\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"kind\" TEXT NOT NULL, \"xp\" INTEGER NOT NULL DEFAULT 0, \"value\" INTEGER NOT NULL DEFAULT 0, \"ref\" TEXT NULL, \"created_at\" INTEGER NOT NULL);"
        }
      ]
    },
    {
      "name": "lesson_progress",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"lesson_progress\" (\"lesson_id\" TEXT NOT NULL, \"stars\" INTEGER NOT NULL, \"best_accuracy\" REAL NOT NULL, \"completions\" INTEGER NOT NULL DEFAULT 1, \"first_completed_at\" INTEGER NOT NULL, \"last_completed_at\" INTEGER NOT NULL, PRIMARY KEY (\"lesson_id\"));"
        }
      ]
    },
    {
      "name": "achievements",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"achievements\" (\"id\" TEXT NOT NULL, \"unlocked_at\" INTEGER NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "quest_claims",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"quest_claims\" (\"day\" INTEGER NOT NULL, \"quest_id\" TEXT NOT NULL, PRIMARY KEY (\"day\", \"quest_id\"));"
        }
      ]
    }
  ]
}