      {"type": "choice", "q": "이것은 사과___.", "en": "This is an apple.", "options": ["예요", "이에요"], "explain": "사과 ends in a vowel → 예요"},
      {"type": "choice", "q": "저는 회사원___.", "en": "I'm an office worker.", "options": ["이에요", "예요"], "explain": "회사원 ends in ㄴ → 이에요"},
      {"type": "choice", "q": "제 이름은 민수___.", "en": "My name is Minsu.", "options": ["예요", "이에요"], "explain": "민수 ends in a vowel → 예요"},
      {"type": "build", "en": "This is water.", "ko": "이것은 물이에요", "extra": ["물예요"]},
      {"type": "meaning", "ko": "이게 뭐예요?", "options": ["What is this?", "Where is this?", "Who is this?"]}
     ],
     "drills": [{"particle": "copula", "count": 2}]
