       "table": [["Noun ends in", "Use", "Example"], ["consonant", "이에요", "학생이에요"], ["vowel", "예요", "의사예요"]],
       "examples": [{"ko": "저는 학생이에요.", "en": "I'm a student."}, {"ko": "이것은 사과예요.", "en": "This is an apple."}, {"ko": "제 이름은 민수예요.", "en": "My name is Minsu."}]},
      {"title": "Asking", "body": "Same words, rising voice: **학생이에요?** = *Are you a student?*",
