       "examples": [{"ko": "이름이 뭐예요?", "en": "What's your name?"}, {"ko": "화장실이 어디예요?", "en": "Where's the bathroom?"}, {"ko": "생일이 언제예요?", "en": "When's your birthday?"}, {"ko": "저 사람은 누구예요?", "en": "Who is that person?"}]}
     ],
     "practice": [
