  {
   "id": "particles", "title": "Noun particles", "titleKo": "조사", "emoji": "🧲",
   "lessons": [
    {
     "id": "p1", "title": "은 / 는", "subtitle": "Topic: as for…",
     "cards": [
      {"title": "As for…", "body": "**은/는** marks the topic — what the sentence is about. **은** after a consonant, **는** after a vowel.",
       "table": [["Ends in", "Particle", "Example"], ["consonant", "은", "책은"], ["vowel", "는", "저는"]],
       "examples": [{"ko": "저는 민수예요.", "en": "I'm Minsu."}, {"ko": "오늘은 월요일이에요.", "en": "Today is Monday."}, {"ko": "이 책은 재미있어요.", "en": "This book is interesting."}]},
      {"title": "Contrast", "body": "**은/는** also contrasts things: *X…, but Y…*",
       "examples": [{"ko": "커피는 좋아해요.", "en": "Coffee, I like. (but maybe not tea)"}, {"ko": "고기는 안 먹어요.", "en": "Meat, I don't eat."}]}
     ],
     "practice": [
      {"type": "choice", "q": "저___ 학생이에요.", "en": "I'm a student.", "options": ["는", "은"], "explain": "저 ends in a vowel → 는"},
      {"type": "choice", "q": "오늘___ 금요일이에요.", "en": "Today is Friday.", "options": ["은", "는"], "explain": "오늘 ends in ㄹ → 은"},
      {"type": "choice", "q": "이 사과___ 맛있어요.", "en": "This apple is tasty.", "options": ["는", "은"], "explain": "사과 ends in a vowel → 는"},
      {"type": "choice", "q": "동생___ 키가 커요.", "en": "My younger sibling is tall.", "options": ["은", "는"], "explain": "동생 ends in ㅇ → 은"},
      {"type": "build", "en": "I'm Minsu.", "ko": "저는 민수예요", "extra": ["저은"]}
     ],
     "drills": [{"particle": "topic", "count": 3}]
    },
    {
     "id": "p2", "title": "이 / 가", "subtitle": "Subject: who does it",
     "cards": [
      {"title": "Who does it", "body": "**이/가** marks the subject — often new information, or the answer to *who? / what?*. **이** after a consonant, **가** after a vowel.",
       "examples": [{"ko": "비가 와요.", "en": "It's raining. (rain comes)"}, {"ko": "친구가 왔어요.", "en": "My friend came."}, {"ko": "누가 왔어요?", "en": "Who came?"}]},
      {"title": "은/는 or 이/가?", "body": "Rough guide: **은/는** = what we're talking about (known, or contrasted). **이/가** = who or what does it (new, focused). Question words take **이/가**: 누가, 뭐가.",
       "examples": [{"ko": "저는 학생이에요.", "en": "I am a student. (talking about me)"}, {"ko": "제가 할게요.", "en": "I'll do it. (me, not someone else)"}, {"ko": "날씨가 좋아요.", "en": "The weather is nice."}]},
      {"title": "Special shapes", "body": "A few words change before 가: **나 → 내가**, **저 → 제가**, **너 → 네가**, **누구 → 누가**.",
       "examples": [{"ko": "제가 민수예요.", "en": "I'm Minsu. (the one you're looking for)"}]}
     ],
     "practice": [
      {"type": "choice", "q": "비___ 와요.", "en": "It's raining.", "options": ["가", "이"], "explain": "비 ends in a vowel → 가"},
      {"type": "choice", "q": "물___ 없어요.", "en": "There's no water.", "options": ["이", "가"], "explain": "물 ends in ㄹ → 이"},
      {"type": "choice", "q": "___ 왔어요?", "en": "Who came?", "options": ["누가", "누구가", "누구는"], "explain": "누구 + 가 → 누가"},
      {"type": "choice", "q": "날씨___ 좋아요.", "en": "The weather is nice.", "options": ["가", "이"]},
      {"type": "build", "en": "My friend came.", "ko": "친구가 왔어요", "extra": ["친구를"]},
      {"type": "meaning", "ko": "제가 할게요.", "options": ["I'll do it.", "You do it.", "I did it."]}
