     "cards": [
      {"title": "Is not", "body": "Noun + **이/가 아니에요** = *is not*. **이** after a consonant, **가** after a vowel.",
       "examples": [{"ko": "저는 학생이 아니에요.", "en": "I'm not a student."}, {"ko": "이것은 커피가 아니에요.", "en": "This isn't coffee."}]},
