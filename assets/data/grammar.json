    },
    {
     "id": "b4", "title": "있어요 / 없어요", "subtitle": "There is · I have",
     "cards": [
      {"title": "Exist / have", "body": "**있어요** = *there is / I have*. **없어요** = *there isn't / I don't have*.",
       "formula": ["시간이|time", "있어요|exists"],
       "examples": [{"ko": "시간이 있어요.", "en": "I have time."}, {"ko": "돈이 없어요.", "en": "I have no money."}, {"ko": "질문이 있어요.", "en": "I have a question."}]},
      {"title": "Where something is", "body": "Place + **에 있어요** = *is at / in* the place.",
       "examples": [{"ko": "고양이가 집에 있어요.", "en": "The cat is at home."}, {"ko": "은행이 어디에 있어요?", "en": "Where is the bank?"}, {"ko": "가방 안에 책이 있어요.", "en": "There's a book in the bag."}]},
      {"title": "Handy words built from it", "body": "**맛있어요** = it's delicious (*taste exists*), **재미있어요** = it's fun, **재미없어요** = it's boring.",
       "examples": [{"ko": "이 음식은 맛있어요.", "en": "This food is delicious."}, {"ko": "영화가 재미있어요.", "en": "The movie is fun."}]}
     ],
     "practice": [
      {"type": "choice", "q": "시간이 ___.", "en": "I don't have time.", "options": ["없어요", "있어요"]},
      {"type": "choice", "q": "질문이 ___.", "en": "I have a question.", "options": ["있어요", "없어요"]},
      {"type": "choice", "q": "고양이가 집___ 있어요.", "en": "The cat is at home.", "options": ["에", "를", "는"]},
      {"type": "build", "en": "There is a book in the bag.", "ko": "가방 안에 책이 있어요", "extra": ["없어요"]},
      {"type": "build", "en": "Where is the bank?", "ko": "은행이 어디에 있어요?", "extra": ["뭐"]},
      {"type": "meaning", "ko": "영화가 재미없어요.", "options": ["The movie is boring.", "The movie is fun.", "There is no movie."]}
