      {"type": "choice", "q": "이름이 ___예요?", "en": "What is your name?", "options": ["뭐", "어디", "언제"]},
      {"type": "choice", "q": "생일이 ___예요?", "en": "When is your birthday?", "options": ["언제", "누구", "어디"]},
      {"type": "build", "en": "I'm not a teacher.", "ko": "저는 선생님이 아니에요", "extra": ["선생님가"]},
      {"type": "meaning", "ko": "저 사람은 누구예요?", "options": ["Who is that person?", "Where is that person?", "What is that?"]}
