     "id": "b1", "title": "How a sentence works", "subtitle": "The verb goes last",
     "cards": [
      {"title": "The verb goes last", "body": "English says *I eat rice*. Korean says *I rice eat*. The verb (or adjective) always comes at the **end** of the sentence.",
       "formula": ["저는|I (topic)", "밥을|rice (object)", "먹어요|eat"],
       "examples": [{"ko": "저는 밥을 먹어요.", "en": "I eat rice."}, {"ko": "친구가 커피를 마셔요.", "en": "My friend drinks coffee."}, {"ko": "저는 한국어를 공부해요.", "en": "I study Korean."}]},
      {"title": "Little tags show each word's job", "body": "Small endings called **particles** stick to nouns and tell you their role: **은/는** = topic, **이/가** = subject, **을/를** = object. Thanks to these tags the order of the nouns can move around — but the verb stays last.",
       "examples": [{"ko": "저는 사과를 좋아해요.", "en": "I like apples."}, {"ko": "사과를 저는 좋아해요.", "en": "Apples, I like. (same meaning, different focus)"}]},
      {"title": "Adding time and place", "body": "A natural order is **Who → When → Where → What → Verb**.",
       "formula": ["저는|I", "오늘|today", "학교에서|at school", "한국어를|Korean", "공부해요|study"],
       "examples": [{"ko": "저는 오늘 학교에서 한국어를 공부해요.", "en": "I study Korean at school today."}]},
      {"title": "Drop what's obvious", "body": "Koreans leave out *I* and *you* whenever it's clear from context. A whole sentence can be just the verb!",
       "examples": [{"ko": "밥 먹었어요?", "en": "(Did you) eat?"}, {"ko": "네, 먹었어요.", "en": "Yes, (I) ate."}]}
     ],
     "practice": [
      {"type": "quiz", "q": "Where does the verb go in a Korean sentence?", "options": ["At the end", "At the start", "Right after the subject"]},
      {"type": "build", "en": "I eat rice.", "ko": "저는 밥을 먹어요", "extra": ["물을"]},
      {"type": "build", "en": "My friend drinks coffee.", "ko": "친구가 커피를 마셔요", "extra": ["밥을"]},
      {"type": "meaning", "ko": "저는 사과를 좋아해요.", "options": ["I like apples.", "Apples like me.", "I eat apples."]},
      {"type": "build", "en": "I study Korean at school today.", "ko": "저는 오늘 학교에서 한국어를 공부해요", "extra": []},
      {"type": "meaning", "ko": "밥 먹었어요?", "options": ["Did you eat?", "Is there rice?", "I ate rice."]}
     ]
    },
    {
     "id": "b2", "title": "이에요 / 예요", "subtitle": "To be: A is B",
     "cards": [
