  {"id": "phrases_cafe", "title": "Café & restaurant", "titleKo": "카페와 식당", "emoji": "☕"},
  {"id": "phrases_shopping", "title": "Shopping & paying", "titleKo": "쇼핑", "emoji": "💳"},
  {"id": "phrases_around", "title": "Getting around", "titleKo": "길 찾기", "emoji": "🗺️"},
  {"id": "phrases_people", "title": "Meeting people", "titleKo": "사람 만나기", "emoji": "🤝"},
  {"id": "phrases_reactions", "title": "Reactions & small talk", "titleKo": "맞장구", "emoji": "😮"},
