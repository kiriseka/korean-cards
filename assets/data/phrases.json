 ],
 "phrases": [
  {"id": 20000001, "unit": "phrases_basics", "ko": "안녕하세요.", "en": "Hello.", "lit": "Are you at peace?", "note": "Works any time of day, with anyone."},
  {"id": 20000002, "unit": "phrases_basics", "ko": "안녕히 가세요.", "en": "Goodbye. (to someone leaving)", "lit": "Go in peace."},
  {"id": 20000003, "unit": "phrases_basics", "ko": "안녕히 계세요.", "en": "Goodbye. (when you are leaving)", "lit": "Stay in peace."},
  {"id": 20000004, "unit": "phrases_basics", "ko": "감사합니다.", "en": "Thank you.", "note": "Formal and always safe."},
  {"id": 20000005, "unit": "phrases_basics", "ko": "고마워요.", "en": "Thanks.", "note": "Polite but warmer than 감사합니다."},
  {"id": 20000006, "unit": "phrases_basics", "ko": "죄송합니다.", "en": "I'm sorry. (formal)"},
  {"id": 20000007, "unit": "phrases_basics", "ko": "미안해요.", "en": "Sorry."},
  {"id": 20000008, "unit": "phrases_basics", "ko": "괜찮아요.", "en": "It's okay. / I'm fine. / No, thanks.", "note": "One of the most useful words: also politely refuses an offer."},
  {"id": 20000009, "unit": "phrases_basics", "ko": "네.", "en": "Yes. / I see.", "note": "Also used like 'uh-huh' while listening."},
  {"id": 20000010, "unit": "phrases_basics", "ko": "아니요.", "en": "No."},
  {"id": 20000011, "unit": "phrases_basics", "ko": "잠깐만요.", "en": "Just a moment. / Excuse me (let me through).", "lit": "only a moment"},
  {"id": 20000012, "unit": "phrases_basics", "ko": "저기요.", "en": "Excuse me! (to get attention)", "lit": "over there", "note": "How you call a waiter."},
  {"id": 20000013, "unit": "phrases_basics", "ko": "실례합니다.", "en": "Excuse me. (before interrupting)", "lit": "I commit a rudeness"},
  {"id": 20000014, "unit": "phrases_basics", "ko": "처음 뵙겠습니다.", "en": "Nice to meet you. (formal, first meeting)", "lit": "I see you for the first time"},
  {"id": 20000015, "unit": "phrases_basics", "ko": "만나서 반가워요.", "en": "Nice to meet you.", "lit": "meeting (you), I'm glad"},
  {"id": 20000016, "unit": "phrases_basics", "ko": "잘 부탁드려요.", "en": "I look forward to working with you.", "lit": "I ask (you) well", "note": "Said after introducing yourself."},
  {"id": 20000017, "unit": "phrases_basics", "ko": "수고하세요.", "en": "Have a good one. (leaving a shop)", "lit": "please keep working hard"},
  {"id": 20000018, "unit": "phrases_basics", "ko": "맛있게 드세요.", "en": "Enjoy your meal.", "lit": "eat deliciously"},
  {"id": 20000019, "unit": "phrases_basics", "ko": "잘 먹겠습니다.", "en": "Thanks for the food. (before eating)", "lit": "I will eat well"},
  {"id": 20000020, "unit": "phrases_basics", "ko": "잘 먹었습니다.", "en": "Thanks for the meal. (after eating)", "lit": "I ate well"},

  {"id": 20000021, "unit": "phrases_understand", "ko": "다시 말해 주세요.", "en": "Please say it again.", "lit": "again speak-for-me please"},
  {"id": 20000022, "unit": "phrases_understand", "ko": "천천히 말해 주세요.", "en": "Please speak slowly."},
  {"id": 20000023, "unit": "phrases_understand", "ko": "잘 모르겠어요.", "en": "I'm not sure. / I don't really know."},
  {"id": 20000024, "unit": "phrases_understand", "ko": "이해했어요.", "en": "I understood."},
  {"id": 20000025, "unit": "phrases_understand", "ko": "이해가 안 돼요.", "en": "I don't understand.", "lit": "understanding doesn't happen"},
  {"id": 20000026, "unit": "phrases_understand", "ko": "한국어를 조금 해요.", "en": "I speak a little Korean."},
  {"id": 20000027, "unit": "phrases_understand", "ko": "한국어를 잘 못해요.", "en": "I'm not good at Korean."},
  {"id": 20000028, "unit": "phrases_understand", "ko": "영어 할 줄 아세요?", "en": "Do you speak English?", "lit": "do you know how to do English?"},
  {"id": 20000029, "unit": "phrases_understand", "ko": "이게 무슨 뜻이에요?", "en": "What does this mean?"},
  {"id": 20000030, "unit": "phrases_understand", "ko": "한국어로 뭐예요?", "en": "What is it in Korean?"},
  {"id": 20000031, "unit": "phrases_understand", "ko": "이거 어떻게 읽어요?", "en": "How do you read this?"},
  {"id": 20000032, "unit": "phrases_understand", "ko": "써 주세요.", "en": "Please write it down (for me)."},
  {"id": 20000033, "unit": "phrases_understand", "ko": "뭐라고요?", "en": "Pardon? / What did you say?"},
  {"id": 20000034, "unit": "phrases_understand", "ko": "아, 그렇군요.", "en": "Ah, I see."},
  {"id": 20000035, "unit": "phrases_understand", "ko": "맞아요.", "en": "That's right."},
  {"id": 20000036, "unit": "phrases_understand", "ko": "아니에요.", "en": "No, it isn't. / Not at all.", "note": "Also the humble reply to a compliment."},
  {"id": 20000037, "unit": "phrases_understand", "ko": "무슨 말인지 알겠어요.", "en": "I know what you mean."},
  {"id": 20000038, "unit": "phrases_understand", "ko": "한 번 더요.", "en": "One more time, please."},

  {"id": 20000039, "unit": "phrases_cafe", "ko": "메뉴 좀 주세요.", "en": "Could I have the menu, please?", "note": "좀 softens a request, like 'please'."},
  {"id": 20000040, "unit": "phrases_cafe", "ko": "이거 주세요.", "en": "This one, please.", "note": "Point at the menu and say this — it always works."},
  {"id": 20000041, "unit": "phrases_cafe", "ko": "아이스 아메리카노 한 잔 주세요.", "en": "One iced americano, please.", "lit": "ice americano one cup please"},
  {"id": 20000042, "unit": "phrases_cafe", "ko": "따뜻한 걸로 주세요.", "en": "A hot one, please.", "lit": "with a warm one, please"},
  {"id": 20000043, "unit": "phrases_cafe", "ko": "여기서 먹을게요.", "en": "I'll eat here."},
  {"id": 20000044, "unit": "phrases_cafe", "ko": "가져갈게요.", "en": "I'll take it to go."},
  {"id": 20000045, "unit": "phrases_cafe", "ko": "추천해 주세요.", "en": "Please recommend something."},
  {"id": 20000046, "unit": "phrases_cafe", "ko": "뭐가 제일 맛있어요?", "en": "What's the best thing here?", "lit": "what is the most delicious?"},
  {"id": 20000047, "unit": "phrases_cafe", "ko": "안 맵게 해 주세요.", "en": "Please make it not spicy."},
  {"id": 20000048, "unit": "phrases_cafe", "ko": "물 좀 주세요.", "en": "Some water, please."},
  {"id": 20000049, "unit": "phrases_cafe", "ko": "하나 더 주세요.", "en": "One more, please."},
  {"id": 20000050, "unit": "phrases_cafe", "ko": "두 명이에요.", "en": "Two people. (a table for two)"},
  {"id": 20000051, "unit": "phrases_cafe", "ko": "계산해 주세요.", "en": "The bill, please."},
  {"id": 20000052, "unit": "phrases_cafe", "ko": "따로 계산할게요.", "en": "We'll pay separately."},
  {"id": 20000053, "unit": "phrases_cafe", "ko": "카드 돼요?", "en": "Can I pay by card?", "lit": "does card work?"},
  {"id": 20000054, "unit": "phrases_cafe", "ko": "진짜 맛있어요!", "en": "It's really delicious!"},
  {"id": 20000055, "unit": "phrases_cafe", "ko": "배불러요.", "en": "I'm full."},
  {"id": 20000056, "unit": "phrases_cafe", "ko": "배고파요.", "en": "I'm hungry."},
  {"id": 20000057, "unit": "phrases_cafe", "ko": "화장실이 어디예요?", "en": "Where's the bathroom?"},
  {"id": 20000058, "unit": "phrases_cafe", "ko": "포장해 주세요.", "en": "Please pack it to go.", "note": "Also for leftovers at a restaurant."},

  {"id": 20000059, "unit": "phrases_shopping", "ko": "얼마예요?", "en": "How much is it?"},
  {"id": 20000060, "unit": "phrases_shopping", "ko": "이거 얼마예요?", "en": "How much is this?"},
  {"id": 20000061, "unit": "phrases_shopping", "ko": "너무 비싸요.", "en": "It's too expensive."},
  {"id": 20000062, "unit": "phrases_shopping", "ko": "좀 깎아 주세요.", "en": "Could you give me a discount?", "note": "OK at markets, not in chain stores."},
  {"id": 20000063, "unit": "phrases_shopping", "ko": "그냥 구경하는 거예요.", "en": "I'm just looking."},
  {"id": 20000064, "unit": "phrases_shopping", "ko": "다른 색 있어요?", "en": "Do you have another color?"},
  {"id": 20000065, "unit": "phrases_shopping", "ko": "더 큰 거 있어요?", "en": "Do you have a bigger one?"},
  {"id": 20000066, "unit": "phrases_shopping", "ko": "입어 봐도 돼요?", "en": "Can I try it on?", "lit": "is it okay if I try wearing it?"},
  {"id": 20000067, "unit": "phrases_shopping", "ko": "이걸로 할게요.", "en": "I'll take this one."},
  {"id": 20000068, "unit": "phrases_shopping", "ko": "봉투 필요 없어요.", "en": "I don't need a bag."},
  {"id": 20000069, "unit": "phrases_shopping", "ko": "영수증 주세요.", "en": "A receipt, please."},
  {"id": 20000070, "unit": "phrases_shopping", "ko": "현금으로 할게요.", "en": "I'll pay in cash."},
  {"id": 20000071, "unit": "phrases_shopping", "ko": "카드로 할게요.", "en": "I'll pay by card."},
  {"id": 20000072, "unit": "phrases_shopping", "ko": "교환할 수 있어요?", "en": "Can I exchange it?"},
  {"id": 20000073, "unit": "phrases_shopping", "ko": "환불해 주세요.", "en": "I'd like a refund."},
  {"id": 20000074, "unit": "phrases_shopping", "ko": "이거 있어요?", "en": "Do you have this?", "note": "Show a photo on your phone and ask."},
  {"id": 20000075, "unit": "phrases_shopping", "ko": "몇 시에 문 닫아요?", "en": "What time do you close?", "lit": "at what time do you close the door?"},
  {"id": 20000076, "unit": "phrases_shopping", "ko": "여기 있어요.", "en": "Here you are."},

  {"id": 20000077, "unit": "phrases_around", "ko": "여기가 어디예요?", "en": "Where am I? / Where is this place?"},
  {"id": 20000078, "unit": "phrases_around", "ko": "지하철역이 어디예요?", "en": "Where's the subway station?"},
  {"id": 20000079, "unit": "phrases_around", "ko": "이 버스 명동에 가요?", "en": "Does this bus go to Myeongdong?"},
  {"id": 20000080, "unit": "phrases_around", "ko": "여기서 멀어요?", "en": "Is it far from here?"},
  {"id": 20000081, "unit": "phrases_around", "ko": "걸어서 갈 수 있어요?", "en": "Can I walk there?"},
  {"id": 20000082, "unit": "phrases_around", "ko": "오른쪽으로 가세요.", "en": "Go right."},
  {"id": 20000083, "unit": "phrases_around", "ko": "왼쪽으로 가세요.", "en": "Go left."},
  {"id": 20000084, "unit": "phrases_around", "ko": "쭉 가세요.", "en": "Go straight."},
  {"id": 20000085, "unit": "phrases_around", "ko": "여기서 세워 주세요.", "en": "Please stop here. (taxi)"},
  {"id": 20000086, "unit": "phrases_around", "ko": "이 주소로 가 주세요.", "en": "Please take me to this address."},
  {"id": 20000087, "unit": "phrases_around", "ko": "얼마나 걸려요?", "en": "How long does it take?"},
  {"id": 20000088, "unit": "phrases_around", "ko": "길을 잃었어요.", "en": "I'm lost.", "lit": "I lost the road"},
  {"id": 20000089, "unit": "phrases_around", "ko": "다음 역은 어디예요?", "en": "What's the next station?"},
  {"id": 20000090, "unit": "phrases_around", "ko": "어디에서 갈아타요?", "en": "Where do I transfer?"},
  {"id": 20000091, "unit": "phrases_around", "ko": "표 한 장 주세요.", "en": "One ticket, please.", "note": "장 is the counter for flat things: tickets, paper."},
  {"id": 20000092, "unit": "phrases_around", "ko": "지도로 보여 주세요.", "en": "Please show me on the map."},
  {"id": 20000093, "unit": "phrases_around", "ko": "근처에 편의점 있어요?", "en": "Is there a convenience store nearby?"},
  {"id": 20000094, "unit": "phrases_around", "ko": "공항까지 가 주세요.", "en": "To the airport, please."},

  {"id": 20000095, "unit": "phrases_people", "ko": "이름이 뭐예요?", "en": "What's your name?"},
  {"id": 20000096, "unit": "phrases_people", "ko": "저는 외국인이에요.", "en": "I'm a foreigner."},
  {"id": 20000097, "unit": "phrases_people", "ko": "어디에서 왔어요?", "en": "Where are you from?", "lit": "where did you come from?"},
  {"id": 20000098, "unit": "phrases_people", "ko": "인도네시아에서 왔어요.", "en": "I'm from Indonesia.", "note": "Swap in your country: 미국 (USA), 영국 (UK), 호주 (Australia), 필리핀, 베트남…"},
  {"id": 20000099, "unit": "phrases_people", "ko": "무슨 일 하세요?", "en": "What do you do (for work)?"},
  {"id": 20000100, "unit": "phrases_people", "ko": "학생이에요.", "en": "I'm a student."},
  {"id": 20000101, "unit": "phrases_people", "ko": "몇 살이에요?", "en": "How old are you?", "note": "Common in Korea: age decides how polite to be."},
  {"id": 20000102, "unit": "phrases_people", "ko": "취미가 뭐예요?", "en": "What's your hobby?"},
  {"id": 20000103, "unit": "phrases_people", "ko": "한국어 공부하고 있어요.", "en": "I'm studying Korean."},
  {"id": 20000104, "unit": "phrases_people", "ko": "한국에 처음 왔어요.", "en": "It's my first time in Korea."},
  {"id": 20000105, "unit": "phrases_people", "ko": "한국 음식 좋아해요.", "en": "I like Korean food."},
  {"id": 20000106, "unit": "phrases_people", "ko": "연락처 알려 주세요.", "en": "Can I have your contact info?"},
  {"id": 20000107, "unit": "phrases_people", "ko": "카톡 있어요?", "en": "Do you have KakaoTalk?", "note": "KakaoTalk is Korea's main messaging app."},
  {"id": 20000108, "unit": "phrases_people", "ko": "또 만나요.", "en": "Let's meet again."},
  {"id": 20000109, "unit": "phrases_people", "ko": "다음에 봐요.", "en": "See you next time."},
  {"id": 20000110, "unit": "phrases_people", "ko": "주말에 시간 있어요?", "en": "Are you free this weekend?"},
  {"id": 20000111, "unit": "phrases_people", "ko": "같이 밥 먹을래요?", "en": "Do you want to eat together?"},
  {"id": 20000112, "unit": "phrases_people", "ko": "좋아요!", "en": "Sounds good!"},
  {"id": 20000113, "unit": "phrases_people", "ko": "나중에 연락할게요.", "en": "I'll contact you later."},
  {"id": 20000114, "unit": "phrases_people", "ko": "잘 지냈어요?", "en": "How have you been?", "lit": "did you live well?"},

  {"id": 20000115, "unit": "phrases_reactions", "ko": "진짜요?", "en": "Really?"},
  {"id": 20000116, "unit": "phrases_reactions", "ko": "대박!", "en": "Awesome! / No way!", "note": "Casual slang — fine with friends."},
  {"id": 20000117, "unit": "phrases_reactions", "ko": "와, 멋있어요!", "en": "Wow, that's cool!"},
  {"id": 20000118, "unit": "phrases_reactions", "ko": "그래요?", "en": "Is that so?"},
  {"id": 20000119, "unit": "phrases_reactions", "ko": "그렇구나.", "en": "I see. (casual)", "note": "반말 — use with friends."},
  {"id": 20000120, "unit": "phrases_reactions", "ko": "재미있어요.", "en": "It's fun. / It's interesting."},
  {"id": 20000121, "unit": "phrases_reactions", "ko": "좋겠다!", "en": "Lucky you! / That must be nice!", "note": "반말 — use with friends."},
  {"id": 20000122, "unit": "phrases_reactions", "ko": "축하해요!", "en": "Congratulations!"},
  {"id": 20000123, "unit": "phrases_reactions", "ko": "힘내세요!", "en": "Cheer up! / You can do it!", "lit": "please bring out strength"},
  {"id": 20000124, "unit": "phrases_reactions", "ko": "수고했어요.", "en": "Good job. / Thanks for your hard work."},
  {"id": 20000125, "unit": "phrases_reactions", "ko": "걱정하지 마세요.", "en": "Don't worry."},
  {"id": 20000126, "unit": "phrases_reactions", "ko": "물론이죠.", "en": "Of course."},
  {"id": 20000127, "unit": "phrases_reactions", "ko": "아마도요.", "en": "Maybe."},
  {"id": 20000128, "unit": "phrases_reactions", "ko": "글쎄요.", "en": "Well… / I'm not sure.", "note": "Buys you time to think."},
  {"id": 20000129, "unit": "phrases_reactions", "ko": "저도요.", "en": "Me too."},
  {"id": 20000130, "unit": "phrases_reactions", "ko": "정말 고마워요.", "en": "Thank you so much."},
  {"id": 20000131, "unit": "phrases_reactions", "ko": "별말씀을요.", "en": "Don't mention it.", "note": "A polite reply to thanks."},
  {"id": 20000132, "unit": "phrases_reactions", "ko": "날씨가 좋네요.", "en": "Nice weather, isn't it?", "note": "-네요 shares a feeling or discovery."},
  {"id": 20000133, "unit": "phrases_reactions", "ko": "오늘 너무 더워요.", "en": "It's so hot today."},
  {"id": 20000134, "unit": "phrases_reactions", "ko": "피곤해요.", "en": "I'm tired."},

  {"id": 20000135, "unit": "phrases_help", "ko": "도와주세요!", "en": "Help!"},
  {"id": 20000136, "unit": "phrases_help", "ko": "아파요.", "en": "It hurts. / I'm sick."},
  {"id": 20000137, "unit": "phrases_help", "ko": "머리가 아파요.", "en": "I have a headache.", "lit": "head hurts"},
  {"id": 20000138, "unit": "phrases_help", "ko": "배가 아파요.", "en": "My stomach hurts."},
  {"id": 20000139, "unit": "phrases_help", "ko": "병원이 어디예요?", "en": "Where is the hospital?"},
  {"id": 20000140, "unit": "phrases_help", "ko": "약국이 어디예요?", "en": "Where is the pharmacy?"},
  {"id": 20000141, "unit": "phrases_help", "ko": "경찰을 불러 주세요.", "en": "Please call the police."},
  {"id": 20000142, "unit": "phrases_help", "ko": "구급차를 불러 주세요.", "en": "Please call an ambulance.", "note": "The emergency number in Korea is 119."},
  {"id": 20000143, "unit": "phrases_help", "ko": "지갑을 잃어버렸어요.", "en": "I lost my wallet."},
  {"id": 20000144, "unit": "phrases_help", "ko": "휴대폰 좀 빌려 주세요.", "en": "Could I borrow your phone?"},
  {"id": 20000145, "unit": "phrases_help", "ko": "와이파이 비밀번호가 뭐예요?", "en": "What's the Wi-Fi password?"},
